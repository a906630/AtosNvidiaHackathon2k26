# --- NVIDIA NIM (Brev instance) --------------------------------
# On Brev, local NIM can run without an external API key.
NVIDIA_BASE_URL=http://localhost:8000/v1
NVIDIA_API_KEY=no-key
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# Per-agent model routing (optional). Keep commented to fallback to NVIDIA_MODEL.
# NVIDIA_MODEL_SUPERVISOR=meta/llama-3.1-8b-instruct
# NVIDIA_MODEL_DOMAIN_VERIFIER=meta/llama-3.3-70b-instruct
# NVIDIA_MODEL_CROSS_DOMAIN_CORRELATOR=meta/llama-3.1-70b-instruct
# NVIDIA_MODEL_PRIORITY_ASSESSOR=meta/llama-3.1-70b-instruct
# NVIDIA_MODEL_COMMS_GENERATOR=meta/llama-3.1-70b-instruct

# If you use NVIDIA cloud instead of local NIM:
# NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Docker + host NIM on Linux/Brev:
# NVIDIA_BASE_URL=http://host.docker.internal:8000/v1

# --- APP --------------------------------------------------------
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true
APP_TITLE=CZK - Centrum Zarzadzania Kryzysowego
# Docker recommendation (avoid collision with local NIM on :8000):
# APP_PORT=8080
